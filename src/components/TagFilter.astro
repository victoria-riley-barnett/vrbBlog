---
export interface Props {
  tags: { name: string; count: number }[];
}
const { tags } = Astro.props;
---

{tags.length > 0 && (
  <div class="tag-filter" role="group" aria-label="Filter posts by tag">
    <button type="button" class="tag-chip active" data-tag="">All</button>
    {tags.map(({ name, count }) => (
      <button type="button" class="tag-chip" data-tag={name}>
        {name} <span class="tag-count">{count}</span>
      </button>
    ))}
  </div>
)}

<script is:inline>
  (function () {
    const filterBar = document.querySelector('.tag-filter');
    if (!filterBar) return;

    const chips = Array.from(filterBar.querySelectorAll('.tag-chip'));
    const items = Array.from(document.querySelectorAll('.post-item'));

    filterBar.addEventListener('click', function (e) {
      const chip = e.target.closest('.tag-chip');
      if (!chip) return;

      chips.forEach((c) => c.classList.remove('active'));
      chip.classList.add('active');

      const tag = chip.dataset.tag;
      items.forEach((item) => {
        const itemTags = (item.dataset.tags || '').split(',');
        item.hidden = Boolean(tag) && !itemTags.includes(tag);
      });
    });
  })();
</script>

<style>
  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 2rem 0;
  }

  .tag-chip {
    font-family: var(--font-family-sans);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--theme-code-inline-bg);
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .tag-chip:hover {
    color: var(--text-main);
    border-color: var(--primary-color);
  }

  .tag-chip.active {
    background: var(--primary-color);
    color: white;
  }

  .tag-count {
    opacity: 0.7;
    font-size: 0.75em;
  }
</style>
