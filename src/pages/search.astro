---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Search | Victoria Barnett" description="Search this site.">
  <link slot="head" href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <h1>Search</h1>
  <div id="search"></div>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    if (window.PagefindUI) new window.PagefindUI({ element: '#search', showImages: false });
  </script>
</BaseLayout>
