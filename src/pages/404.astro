---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = '404 — Page Not Found';
const description = 'No page at this address.';
const permalink = `${Astro.site.href}404`;
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="not-found">
    <h1>404</h1>
    <p>No page at this address.</p>
    <p class="links">
      <a href="/">Home</a> · <a href="/blog">Blog</a> · <a href="/about">About</a>
    </p>
  </div>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding: 4rem 1rem;
  }

  .not-found h1 {
    font-family: var(--font-family-sans);
    font-size: 5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--primary-color);
    margin-bottom: 0.5rem;
  }

  .not-found p {
    color: var(--text-secondary);
    font-size: 1.125rem;
  }

  .not-found .links {
    margin-top: 2rem;
  }
</style>
