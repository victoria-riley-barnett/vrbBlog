---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---
<BaseLayout wide title="Projects | Victoria Barnett" description="Things Victoria Barnett has built: open-source tools, an ML course, applied ML, and full-stack work.">
  <article class="page page--wide">
    <h1>Projects</h1>
    <p class="lede">Open-source tools, a machine learning course, and applied ML. Most of the code is on <a href="https://github.com/victoria-riley-barnett">GitHub</a>.</p>
    <div class="project-list">
      {projects.map((project) => <ProjectCard project={project} full />)}
    </div>
  </article>
</BaseLayout>
