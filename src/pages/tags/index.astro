---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, tagSlug } from '../../lib/posts';
const posts = await getPublishedPosts();
const tags = new Map<string, string>();
for (const post of posts) for (const tag of post.data.tags || []) tags.set(tagSlug(tag), tag);
const sortedTags = [...tags].sort((a, b) => a[1].localeCompare(b[1]));
---
<BaseLayout title="Tags | Victoria Barnett" description="Browse writing by tag.">
  <h1>Tags</h1>
  <ul class="tags">{sortedTags.map(([slug, tag]) => <li><a href={`/tag/${slug}/`}>{tag}</a></li>)}</ul>
</BaseLayout>
