---
import 'katex/dist/katex.min.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostArticle from '../../components/PostArticle.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getDraftPosts, postSlug, postTitle, type Post } from '../../lib/posts';

interface Props {
  post: Post;
}

export async function getStaticPaths() {
  // Drafts are a local editing surface: nothing is emitted for them in a production build.
  if (!import.meta.env.DEV) return [];
  return (await getDraftPosts()).map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
---
<BaseLayout
  title={`Draft · ${postTitle(post)}`}
  description={post.data.description || 'Draft preview.'}
  noindex
>
  <main class="page-narrow">
    <SiteHeader />
    <Breadcrumbs
      trail={[
        { label: 'Home', href: '/' },
        { label: 'Draft preview' },
        { label: postTitle(post) },
      ]}
    />
    <PostArticle post={post} />
  </main>
</BaseLayout>
