---
import { getPublishedPosts } from '../../lib/posts.js'
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagFilter from '../../components/TagFilter.astro';
import PostIndexList from '../../components/PostIndexList.astro';

const title = 'Blog';
const description = 'Latest articles.';
const permalink = `${Astro.site.href}blog`;

const allPosts = await getPublishedPosts();

const postsByTag = {};
allPosts.forEach(post => {
  (post.data.tags || []).forEach(tag => {
    postsByTag[tag] = (postsByTag[tag] || 0) + 1;
  });
});
const tags = Object.keys(postsByTag).sort().map(name => ({ name, count: postsByTag[name] }));
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="container">
    <h1>Blog</h1>
    <TagFilter tags={tags} />
    <PostIndexList posts={allPosts} />
  </div>
</BaseLayout>
