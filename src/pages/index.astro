---
import { getCollection, render } from 'astro:content';
import projects from '../../content/projects.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemePicker from '../components/ThemePicker.astro';
import { mdxComponents } from '../lib/mdx-components';
import { formatDate, getPublishedPosts, postDate, postSlug, postTitle } from '../lib/posts';

const siteHost = (url: string) => new URL(url).hostname.replace(/^www\./, '');

const pages = await getCollection('pages');
const about = pages.find((page) => page.data.slug === 'about');
const links = pages.find((page) => page.data.slug === 'links');
if (!about) throw new Error('The about page is missing from content/pages.');
if (!links) throw new Error('The links page is missing from content/pages.');
const { Content: AboutContent } = await render(about);
const { Content: LinksContent } = await render(links);
const posts = await Promise.all((await getPublishedPosts()).map(async (post) => ({
  post,
  Content: (await render(post)).Content,
})));
---
<BaseLayout title="Victoria Barnett" description="Links, projects, and writing by Victoria Barnett.">
  <a class="skip-link" href="#projects-and-writing">Skip to content</a>
  <div class="page-layout">
    <main>
      <div class="feed-head">
        <h1 id="projects-and-writing">
          <span id="feed-heading">Projects &amp; Writing</span>
          <span class="feed-filters" id="feed-filters" hidden>
            <button type="button" data-filter="project" aria-pressed="false">Projects</button>
            <span> &amp; </span>
            <button type="button" data-filter="writing" aria-pressed="false">Writing</button>
          </span>
        </h1>
        <ThemePicker />
      </div>
      <div class="feed-intro">
        <nav class="feed-links" id="links" aria-label="Links">
          <div class="prose"><LinksContent components={mdxComponents} /></div>
        </nav>
        <section class="feed-about" id="about">
          <div class="prose"><AboutContent components={mdxComponents} /></div>
        </section>
      </div>
      {posts.map(({ post, Content }) => {
        const date = postDate(post);
        const id = `post-${postSlug(post)}`;
        return (
          <article class="feed-entry" data-entry-type="writing" data-featured={posts[0]?.post === post || undefined}>
            <details class="entry-details">
              <summary>
                <p class="entry-meta">Writing {date && <>· <time datetime={date.toISOString()}>{formatDate(date)}</time></>}</p>
                <h2>{postTitle(post)}</h2>
                {post.data.description && <p class="entry-summary">{post.data.description}</p>}
              </summary>
              <span class="entry-anchor" id={id}></span>
              <div class="prose"><Content components={mdxComponents} /></div>
              <p class="entry-foot">
                {post.data.tags && post.data.tags.length > 0 && <span>{post.data.tags.join(' · ')}</span>}
                <a class="entry-hash" href={`#${id}`} aria-label={`Permalink to ${postTitle(post)}`}>#</a>
              </p>
            </details>
          </article>
        );
      })}
      {projects.map((project) => {
        const id = `project-${project.slug}`;
        const repo = project.repo && `https://github.com/victoria-riley-barnett/${project.repo}`;
        if (!project.paragraphs && !project.image) {
          return (
            <article class="feed-entry entry-brief" data-entry-type="project">
              <span class="entry-anchor" id={id}></span>
              <p class="entry-meta">Project</p>
              <h2>{repo ? <a href={repo}>{project.title}</a> : project.title}</h2>
              <p class="entry-summary">{project.summary}</p>
            </article>
          );
        }
        return (
          <article class="feed-entry" data-entry-type="project">
            <details class="entry-details">
              <summary>
                <p class="entry-meta">Project</p>
                <h2>{project.title}</h2>
                <p class="entry-summary">{project.summary}</p>
                {project.image && (
                  <img
                    class="entry-peek"
                    src={project.image.src}
                    alt={project.image.alt}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </summary>
              <span class="entry-anchor" id={id}></span>
              {project.image && <img class="project-image" src={project.image.src} alt={project.image.alt} loading="lazy" />}
              {project.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {(repo || project.site) && (
                <p>
                  {repo && <a href={repo}>View on GitHub</a>}
                  {repo && project.site && ' · '}
                  {project.site && <a href={project.site}>{siteHost(project.site)}</a>}
                </p>
              )}
              <p class="entry-foot"><a class="entry-hash" href={`#${id}`} aria-label={`Permalink to ${project.title}`}>#</a></p>
            </details>
          </article>
        );
      })}
    </main>
  </div>
  <script is:inline>
    const feedHeading = document.getElementById('feed-heading');
    const feedFilters = document.getElementById('feed-filters');
    const feedIntro = document.querySelector('.feed-intro');
    const filterButtons = feedFilters.querySelectorAll('button[data-filter]');
    const entries = document.querySelectorAll('.feed-entry[data-entry-type]');
    let activeFilter = null;

    function setFilter(filter) {
      activeFilter = filter;
      let firstVisible = true;
      for (const entry of entries) {
        entry.hidden = filter !== null && entry.dataset.entryType !== filter;
        if (!entry.hidden && firstVisible) {
          entry.dataset.featured = '';
          firstVisible = false;
        } else {
          delete entry.dataset.featured;
        }
      }
      for (const button of filterButtons) {
        button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
      }
      // The links and bio sit above the feed, so step aside while a filter runs.
      if (feedIntro) feedIntro.hidden = filter !== null;
    }

    for (const button of filterButtons) {
      button.addEventListener('click', () => {
        setFilter(activeFilter === button.dataset.filter ? null : button.dataset.filter);
      });
    }

    function revealTarget(target) {
      const entry = target?.closest('.feed-entry');
      if (!entry) return false;
      if (entry.hidden) setFilter(null);
      const details = entry.querySelector('.entry-details');
      if (details) details.open = true;
      return true;
    }

    function scrollToTarget(target) {
      const destination = target.classList.contains('entry-anchor') ? target.closest('.feed-entry') : target;
      destination.scrollIntoView();
    }

    document.addEventListener('click', (event) => {
      const link = event.target.closest('a[href^="#"]');
      if (!link || link.classList.contains('skip-link')) return;
      const id = link.getAttribute('href').slice(1);
      const target = document.getElementById(id);
      if (!target) return;
      // Navigate explicitly: the hash may already match, in which case the
      // browser does nothing and the link appears dead on narrow layouts.
      event.preventDefault();
      revealTarget(target);
      scrollToTarget(target);
      history.replaceState(null, '', `#${id}`);
    });

    window.addEventListener('hashchange', () => {
      const target = document.getElementById(location.hash.slice(1));
      if (revealTarget(target)) scrollToTarget(target);
    });

    const initialTarget = document.getElementById(location.hash.slice(1));
    if (revealTarget(initialTarget)) scrollToTarget(initialTarget);
    feedHeading.hidden = true;
    feedFilters.hidden = false;
  </script>
</BaseLayout>
