---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPublishedPosts } from '../lib/posts';
import { projects } from '../data/projects';
const posts = (await getPublishedPosts()).slice(0, 5);
const featured = projects.filter((p) => p.featured);
---
<BaseLayout wide title="Victoria Barnett" description="Victoria Barnett: machine learning lecturer at SF State, data quality and systems work, open-source tools.">
  <section class="intro">
    <h1>Victoria Barnett</h1>
    <p class="lede">I teach machine learning at San Francisco State University, where I designed the intermediate ML course for the PINC program.</p>
    <p>Before that I ran data collection for a physical-AI R&amp;D program, and before that I was a quality assurance inspector in the U.S. Air Force. I build open-source tools for personal computing, and I care most about whether the data and the system underneath a model can be trusted.</p>
    <p class="links"><a href="/projects/">Projects</a> · <a href="/blog/">Writing</a> · <a href="/about/">About</a> · <a href="https://github.com/victoria-riley-barnett">GitHub</a> · <a href="https://www.linkedin.com/in/victoriabarnett0/">LinkedIn</a></p>
  </section>
  <section class="featured">
    <div class="section-head"><h2>Selected projects</h2><a href="/projects/">All projects →</a></div>
    <div class="project-grid">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
  <section class="latest">
    <div class="section-head"><h2>Writing</h2><a href="/blog/">All writing →</a></div>
    <PostList posts={posts} />
  </section>
</BaseLayout>
