---
import BaseLayout from '../layouts/BaseLayout.astro';
import GitHubStats from '../components/GitHubStats.svelte';
import PostIndexList from '../components/PostIndexList.astro';
import { getGitHubStats } from '../lib/github.js';
import { getPublishedPosts } from '../lib/posts.js';

const latestPosts = (await getPublishedPosts()).slice(0, 4);

const title = 'Victoria Barnett';
const description = 'Victoria\'s personal website and blog.';
const permalink = Astro.site.href;

const githubStats = await getGitHubStats();
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="home-container">
    <div class="home-copy">
      <h1>I'm <a href="/about/">Victoria</a></h1>
      <p>
        I teach machine learning at San Francisco State University, where I designed the intermediate ML course for the PINC program, and I build open-source tools — mostly for reading, note-taking, and personal infrastructure. Based in San Francisco.
      </p>
      <div class="stats-section">
        <GitHubStats starCount={githubStats.starCount} />
      </div>
      <section class="latest-posts">
        <h2>Latest Thoughts</h2>
        <PostIndexList posts={latestPosts} />
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .home-container {
    display: flex;
    flex: 1;
    margin: 2em 0;
    min-height: 400px;
  }

  .home-copy {
    flex: 1;
    padding: 0 1em;
    max-width: 800px;
  }

  .home-copy h1 {
    font-weight: 700;
    margin-bottom: 0.5em;
    line-height: 1.3;
  }

  .home-copy p {
    font-size: 1.4em;
    margin-bottom: 1.5em;
  }

  .stats-section {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }

  .hero-image-container {
    margin: 0 1em;
    text-align: center;
  }

  .hero-image-container picture {
    display: block;
    min-height: 250px;
  }

  .caption {
    font-size: .8em;
    font-style: italic;
    text-align: left;
  }

  .hero-image {
    width: 100%;
    max-width: 550px;
    margin-bottom: 1em;
  }

  @media (max-width: 1200px) {
    p {
      font-size: 1.2em;
    }

    .hero-image {
      max-width: 400px;
    }
  }

  @media (max-width: 800px) {
    .home-container {
      flex-direction: column;
    }

    .home-copy {
      flex: 0;
      padding-bottom: 2em;
      text-align: center;
    }
  }

  /* Latest Posts Section */
  .latest-posts {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--theme-code-inline-bg);
  }

  .latest-posts h2 {
    font-family: var(--font-family-sans);
    font-size: 1.8rem;
    margin-bottom: 1.5rem;
    color: var(--text-main);
    text-align: center;
  }
</style>
