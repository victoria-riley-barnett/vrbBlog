---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPublishedPosts } from '../lib/posts';
const posts = (await getPublishedPosts()).slice(0, 5);
---
<BaseLayout title="Victoria Barnett" description="Machine learning, programming, and open-source tools for personal computing.">
  <section class="intro">
    <h1>Victoria Barnett</h1>
    <p class="lede">I teach machine learning at San Francisco State University, where I designed the intermediate ML course for the PINC program.</p>
    <p>I build open-source tools for personal computing. Based in San Francisco.</p>
    <p class="links"><a href="/blog/">Writing</a> · <a href="/projects/">Projects</a> · <a href="/about/">About</a></p>
  </section>
  <section class="latest"><h2>Writing</h2><PostList posts={posts} /></section>
</BaseLayout>
