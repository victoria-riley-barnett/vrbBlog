---
import { getCollection, render } from 'astro:content';
import { projects } from '../lib/projects';
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemePicker from '../components/ThemePicker.astro';
import FeedPost from '../components/FeedPost.astro';
import FeedProject from '../components/FeedProject.astro';
import SiteLinks from '../components/SiteLinks.astro';
import { mdxComponents } from '../lib/mdx-components';
import { getPublishedPosts } from '../lib/posts';

const pages = await getCollection('pages');
const about = pages.find((page) => page.data.slug === 'about');
if (!about) throw new Error('The about page is missing from content/pages.');
const { Content: AboutContent } = await render(about);
const entries = [
  ...(await getPublishedPosts()).map((post) => ({ kind: 'post' as const, order: post.data.order, post })),
  ...projects.map((project) => ({ kind: 'project' as const, order: project.order, project })),
].sort((a, b) => (a.order ?? Infinity) - (b.order ?? Infinity));
---
<BaseLayout title="Victoria Barnett" description="Links, projects, and writing by Victoria Barnett.">
  <a class="skip-link" href="#projects-and-writing">Skip to content</a>
  <div class="page-layout">
    <main>
      <header class="hero">
        <h1>Victoria Barnett</h1>
        <p class="hero-tagline">ML, data operations, teaching.</p>
        <p class="hero-lede">
          CS lecturer at SF State. I've run multi-site data-collection operations for a physical-AI
          company, debugged hardware and telemetry pipelines, and teach students to build transformers
          from scratch in PyTorch.
        </p>
        <SiteLinks />
        <p class="hero-now">
          Currently teaching CSC 411 at SF State through December 2026. Looking for full-time ML/DataOps
          roles in San Francisco.
        </p>
      </header>
      <div class="feed-head">
        <h2 id="projects-and-writing">Projects &amp; Writing</h2>
        <ThemePicker />
      </div>
      <aside class="feed-intro">
        <section class="feed-about" id="about">
          <div class="prose"><AboutContent components={mdxComponents} /></div>
        </section>
      </aside>
      {entries.map((entry, index) => (
        entry.kind === 'post' ? (
          <FeedPost post={entry.post} featured={index === 0} />
        ) : (
          <FeedProject project={entry.project} featured={index === 0} />
        )
      ))}
    </main>
  </div>
</BaseLayout>
